{
  "name": "mots-backend",
  "version": "1.0.0",
  "description": "Backend API for Mots French vocabulary learning app",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "tsx src/cli/db-cli.ts init",
    "db:test": "tsx src/cli/db-cli.ts test",
    "db:migrate": "tsx src/cli/db-cli.ts migrate",
    "db:reset": "tsx src/cli/db-cli.ts reset",
    "db:seed": "tsx src/cli/db-cli.ts seed",
    "db:status": "tsx src/cli/db-cli.ts status",
    "db:migrate:legacy": "tsx src/database/migrate.ts",
    "db:seed:legacy": "tsx src/database/seed.ts",
    "db:reset:legacy": "tsx src/database/reset.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  }
}