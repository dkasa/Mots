# 服务器配置
PORT=3001
NODE_ENV=development

# CORS配置
CORS_ORIGIN=http://localhost:2402

# 数据库配置
# 设置为 true 启用 PostgreSQL，false 使用 JSON 文件存储
USE_POSTGRES=true

# PostgreSQL 配置 (当 USE_POSTGRES=true 时生效)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mots
DB_USER=postgres
DB_PASSWORD=password

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# API密钥加密配置
ENCRYPTION_KEY=your-32-character-encryption-key-here!

# 前端URL
FRONTEND_URL=http://localhost:2402